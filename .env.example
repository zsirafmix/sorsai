# ===================================================
# SorsAI Environment Variables
# ===================================================

# Application
PORT=3000
NODE_ENV=production
NEXT_PUBLIC_APP_MODE=live
NEXT_PUBLIC_ADMIN_SECRET=sorsai-admin-2026

# AI Provider Configuration ('gemini' | 'openai' | 'anthropic' | 'mock')
AI_PROVIDER_DEFAULT=gemini

# OpenAI / OpenAI-compatible (Groq, Mistral, Together, OpenRouter)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Supabase (Optional - LocalStorage Demo fallback works if not configured)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
